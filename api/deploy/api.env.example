# /etc/turbo/api.env : chmod 600, owner turbo. The API refuses to start in production if anything marked REQUIRED is weak or missing.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1                         # keep it: only nginx may reach the API. Never 0.0.0.0
PUBLIC_URL=https://api.yourdomain.com  # REQUIRED  https address of THIS api (signed upload/read links are built from it)
SHARE_BASE_URL=https://yourdomain.com/t # REQUIRED  page that shows a shared trip; it calls GET /public/trip-shares/{token}
CORS_ORIGINS=https://admin.yourdomain.com,https://app.yourdomain.com   # explicit https origins only, no *
UPLOAD_DIR=/var/lib/turbo/uploads      # private; NOT served by nginx; back it up with the database
OTP_GLOBAL_PER_HOUR=3000               # hard ceiling on sign-in SMS per hour (SMS-pumping fraud guard)
RATE_LIMIT_PER_MIN=300                 # per signed-in account
DATABASE_URL=postgres://turbo:<password printed by setup-vps.sh>@127.0.0.1:6432/turbo
PG_POOL_MAX=20
WEB_CONCURRENCY=0                      # 0 = one process per core
JWT_SECRET=                            # REQUIRED  openssl rand -base64 48
DATA_ENC_KEY=                          # REQUIRED  openssl rand -base64 32  (encrypts staff MFA seeds; do NOT change after staff enrol)
STAFF_MFA=required                     # REQUIRED in production
ADMIN_URL=https://admin.yourdomain.com # base of the links in invite and reset emails
OTP_MODE=sms                           # REQUIRED
SMS_PROVIDER=texify                    # REQUIRED
TEXIFY_API_KEY=txf_
SMS_SENDER=Turbo                       # must be a sender ID approved in Texify
EMAIL_PROVIDER=smtp                    # REQUIRED (staff invites and password resets)
SMTP_HOST=
SMTP_PORT=587                          # 587 = STARTTLS, 465 = implicit TLS
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Turbo <no-reply@yourdomain.com>
PAYMENT_PROVIDER=payaza                # REQUIRED (fake is refused)
PAYAZA_WEBHOOK_SECRET=
PAYAZA_PUBLIC_KEY_B64=
PAYAZA_TENANT=test                     # switch to live only after Turbo's KYB is approved
FCM_PROVIDER=fcm                       # REQUIRED  fcm = real push; off = disable (apps then rely on polling). console is refused in production
FCM_SERVICE_ACCOUNT=/etc/turbo/firebase-service-account.json   # REQUIRED for fcm: Firebase console > Project settings > Service accounts > Generate key. chmod 600
GOOGLE_MAPS_KEY=
TERMS_VERSION=1.0                      # bump when the terms change: every student/driver is asked to accept again (403 terms_not_accepted)
PRIVACY_VERSION=1.0
TERMS_URL=https://yourdomain.com/terms   # REQUIRED  real https pages
PRIVACY_URL=https://yourdomain.com/privacy # REQUIRED
MIN_APP_VERSION_IOS=0.0.0              # apps older than this get 426 upgrade_required
MIN_APP_VERSION_ANDROID=0.0.0
MIN_APP_VERSION_WEB=0.0.0
MAINTENANCE=false                      # true shows the maintenance screen in the apps
MAINTENANCE_MESSAGE=
ALERT_WEBHOOK_URL=                     # Slack/Discord-style incoming webhook for deploy/alert-check.sh

# --- Operational alerts (optional until switched on; the API runs the same without them) ---
# From inlet: Products -> Keys. Both are needed; with either missing, alerts are off and one log line says so.
# INLET_SECRET_KEY=sk_live_...
# INLET_PRODUCT_ID=prd_...
# E.164 number that gets a direct SMS (Texify) if an SOS is not acknowledged within 2 minutes, independent of inlet.
# SOS_ONCALL_PHONE=+233...
