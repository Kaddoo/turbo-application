NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://localhost:5432/turbo
PG_POOL_MAX=10
JWT_SECRET=change-me-32-bytes-minimum-change-me
# OTP_MODE=fixed accepts 123456 for every phone (demo only). Use "sms" in production.
OTP_MODE=fixed
# SMS: console prints the code instead of sending. Production uses texify (needs TEXIFY_API_KEY and an approved SMS_SENDER).
SMS_PROVIDER=console
# TEXIFY_API_KEY=txf_
# SMS_SENDER=Turbo

# Email: console prints instead of sending. Production uses smtp.
EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587          # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Turbo <no-reply@localhost>

PAYMENT_PROVIDER=fake
PAYAZA_WEBHOOK_SECRET=change-me-payaza-secret
# Set to use Google Routes API; empty uses a straight-line x 1.3 estimate
GOOGLE_MAPS_KEY=
# Number of API processes; 0 = one per CPU core
WEB_CONCURRENCY=0
LOG_LEVEL=info
ADMIN_LOGIN_PER_10MIN=1000   # dev/test only

# Private upload directory (must NOT be served by nginx) and the public base URL used in signed links
UPLOAD_DIR=./data/uploads
PUBLIC_URL=http://localhost:3000

# Contract: terms versions students must accept, and the minimum app versions (older apps get 426)
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# Push: console prints instead of sending (development). Production uses fcm + a Firebase service-account file.
FCM_PROVIDER=console
