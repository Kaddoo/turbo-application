# Copy to .env.local (git-ignored). Never put secrets here.

# Development: leave VITE_API_BASE_URL unset so calls go to /api on the dev
# server, which proxies them to API_PROXY_TARGET (same origin, so the
# SameSite=Strict refresh cookie works).
#   Prism mock:  http://localhost:4010
#   Real API:    http://localhost:3000
API_PROXY_TARGET=http://localhost:4010

# Deployed builds: the API on the same site as the dashboard, with /v1, e.g.
# VITE_API_BASE_URL=https://api.staging.turbo.example/v1
# The dashboard's exact origin must be in the API's CORS_ORIGINS.

VITE_APP_ENV=local
VITE_APP_VERSION=0.1.0
