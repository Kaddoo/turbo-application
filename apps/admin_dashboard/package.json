{
  "name": "turbo-admin-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../api/contract/openapi.yaml -o src/api/schema.d.ts && node -e \"require('fs').writeFileSync('src/api/.contract-sha256', require('crypto').createHash('sha256').update(require('fs').readFileSync('../../api/contract/openapi.yaml')).digest('hex')+'\\n')\"",
    "check": "npm run gen:api && git diff --exit-code src/api/schema.d.ts && npm run typecheck && npm test",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "geist": "1.9.0",
    "leaflet": "1.9.4",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
