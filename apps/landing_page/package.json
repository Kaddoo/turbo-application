{
  "name": "turbo-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run mock:write && PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL:-/mock-api} next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "build:mock": "npm run mock:write && PUBLIC_API_BASE_URL=/mock-api next build",
    "gen:api": "openapi-typescript ../../api/contract/openapi.yaml -o src/api/schema.d.ts && node -e \"require('fs').writeFileSync('src/api/.contract-sha256', require('crypto').createHash('sha256').update(require('fs').readFileSync('../../api/contract/openapi.yaml')).digest('hex')+'\\n')\"",
    "test": "node --test test/*.test.ts",
    "mock:write": "node scripts/write-mock.ts",
    "images": "node scripts/images.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "openapi-fetch": "0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
